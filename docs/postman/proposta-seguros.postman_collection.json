    {
      "name": "05 — Fluxo VPS InMemory",
      "description": "CPF valido gerado automaticamente — InMemory\nAntes: ./scripts/set-banco.sh --disable",
      "item": [
        {
          "name": "05.1 [AUTO] Criar Proposta",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "function gerarCPF() {",
              "    const n = Array.from({length: 9}, () => Math.floor(Math.random() * 10));",
              "    let soma = n.reduce((acc, val, i) => acc + val * (10 - i), 0);",
              "    let d1 = (soma * 10) % 11; if (d1 >= 10) d1 = 0;",
              "    soma = [...n, d1].reduce((acc, val, i) => acc + val * (11 - i), 0);",
              "    let d2 = (soma * 10) % 11; if (d2 >= 10) d2 = 0;",
              "    const cpf = [...n, d1, d2];",
              "    return cpf.slice(0,3).join('') + '.' + cpf.slice(3,6).join('') + '.' + cpf.slice(6,9).join('') + '-' + cpf.slice(9).join('');",
              "}",
              "const nomes  = ['Ana Lima','Carlos Souza','Maria Silva','Pedro Costa','Julia Mendes','Roberto Alves'];",
              "const tipos  = [1,2,3,4,5];",
              "const valores = {1:150,2:80,3:25,4:45,5:15};",
              "const nome  = nomes[Math.floor(Math.random()*nomes.length)];",
              "const cpf   = gerarCPF();",
              "const tipo  = tipos[Math.floor(Math.random()*tipos.length)];",
              "const valor = valores[tipo] + Math.floor(Math.random()*100);",
              "pm.environment.set('rand_nome',  nome);",
              "pm.environment.set('rand_cpf',   cpf);",
              "pm.environment.set('rand_tipo',  tipo);",
              "pm.environment.set('rand_valor', valor);",
              "console.log('=== DADOS GERADOS (InMemory) ===');",
              "console.log('Nome:', nome, '| CPF:', cpf, '| Tipo:', tipo, '| Valor:', valor);"
            ]}},
            { "listen": "test", "script": { "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.environment.set('proposta_id', b.id);",
              "pm.environment.set('cpf', b.cpf);",
              "console.log('Proposta criada:', b.id, '| Tipo:', b.tipoSeguro);"
            ]}}
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nomeCliente\": \"{{rand_nome}}\",\n  \"cpf\": \"{{rand_cpf}}\",\n  \"tipoSeguro\": {{rand_tipo}},\n  \"valor\": {{rand_valor}}\n}" },
            "url": { "raw": "{{base_proposta}}/api/Propostas", "host": ["{{base_proposta}}"], "path": ["api", "Propostas"] }
          }
        },
        {
          "name": "05.2 [AUTO] Aprovar Proposta",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Aprovada', () => pm.expect(pm.response.json().status).to.eql('Aprovada'));"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"novoStatus\": 2\n}" },
            "url": { "raw": "{{base_proposta}}/api/Propostas/{{proposta_id}}/status", "host": ["{{base_proposta}}"], "path": ["api", "Propostas", "{{proposta_id}}", "status"] }
          }
        },
        {
          "name": "05.3 [AUTO] Contratar Proposta",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const b = pm.response.json(); pm.environment.set('contratacao_id', b.id);",
            "console.log('Contratacao criada:', b.id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"propostaId\": \"{{proposta_id}}\",\n  \"cpf\": \"{{cpf}}\"\n}" },
            "url": { "raw": "{{base_contratacao}}/api/Contratacoes", "host": ["{{base_contratacao}}"], "path": ["api", "Contratacoes"] }
          }
        },
        {
          "name": "05.4 [AUTO] Verificar Contratacao",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Contratacao OK', () => pm.expect(pm.response.json().propostaId).to.eql(pm.environment.get('proposta_id')));",
            "console.log('=== FLUXO INMEMORY CONCLUIDO COM SUCESSO! ===');"
          ]}}],
